{
  "datasets": [
    {
      "name": "8efbd95b",
      "displayName": "Top Five Same Zipcode Taxi Trip Summaries",
      "queryLines": [
        "select sum(fare_amount) total_amoint,count(*) trip_count,pickup_zip from samples.nyctaxi.trips \r\n",
        "where pickup_zip = dropoff_zip\r\n",
        "group by pickup_zip\r\n",
        "order by 1 desc\r\n",
        "limit 5;"
      ],
      "catalog": "samples",
      "schema": "nyctaxi"
    },
    {
      "name": "e816948b",
      "displayName": "New York City Taxi Trips Filtered by Pickup Zip",
      "queryLines": [
        "select\n",
        "  *\n",
        "from\n",
        "  samples.nyctaxi.trips\n",
        "where\n",
        "  pickup_zip = :pickup_zip\n",
        "  and dropoff_zip = :pickup_zip\n",
        "order by\n",
        "  1 desc"
      ],
      "parameters": [
        {
          "displayName": "Pickup Zipcode",
          "keyword": "pickup_zip",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {
              "dataType": "INTEGER",
              "values": [
                {
                  "value": "10001"
                }
              ]
            }
          }
        }
      ]
    }
  ],
