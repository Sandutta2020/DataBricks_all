{
  "datasets": [
    {
      "name": "60845306",
      "displayName": "Summary sql",
      "queryLines": [
        "WITH q AS (\r\n",
        "  SELECT\r\n",
        "    COUNT(*) AS `Total Count`,\r\n",
        "    COUNT(DISTINCT LMS_INSTALLATION_ID) AS `Distinct LMS Installation ID`,\r\n",
        "    TOOL_PROVIDER AS `Tool Provider`\r\n",
        "  FROM\r\n",
        "    adhoc_write_qastg.dna_de.Lure_orcl_data_bronze\r\n",
        "  WHERE\r\n",
        "    TOOL_PROVIDER NOT IN ('Connect', 'Simnet')\r\n",
        "  GROUP BY\r\n",
        "    TOOL_PROVIDER\r\n",
        "  ORDER BY\r\n",
        "    COUNT(*) DESC\r\n",
        ")\r\n",
        "SELECT\r\n",
        "  `Tool Provider` `Tool Provider`,\r\n",
        "  `Total Count` `Total Count`,\r\n",
        "  `Distinct LMS Installation ID` `Distinct LMS Installation ID`\r\n",
        "FROM\r\n",
        "  q"
      ],
      "catalog": "adhoc_write_qastg",
      "schema": "dna_de"
    },
    {
      "name": "07c6daaf",
      "displayName": "Detail sql",
      "queryLines": [
        "WITH `Detail_Report` AS (\n",
        "  WITH q AS (\n",
        "    SELECT\n",
        "      LMS_INSTALLATION_ID,\n",
        "      TOOL_PROVIDER,\n",
        "      LMS_CONTEXT_TITLE\n",
        "    FROM\n",
        "      adhoc_write_qastg.dna_de.Lure_orcl_data_bronze\n",
        "    WHERE\n",
        "      (TOOL_PROVIDER = :param1)\n",
        "  )\n",
        "  SELECT\n",
        "    `LMS_INSTALLATION_ID` `LMS_INSTALLATION_ID`,\n",
        "    `TOOL_PROVIDER` `TOOL_PROVIDER`,\n",
        "    `LMS_CONTEXT_TITLE` `LMS_CONTEXT_TITLE`\n",
        "  FROM\n",
        "    q\n",
        ")\n",
        "SELECT\n",
        "  `Detail_Report`.`LMS_INSTALLATION_ID` `Detail_Report__LMS_INSTALLATION_ID`,\n",
        "  `Detail_Report`.`TOOL_PROVIDER` `Detail_Report__TOOL_PROVIDER`,\n",
        "  `Detail_Report`.`LMS_CONTEXT_TITLE` `Detail_Report__LMS_CONTEXT_TITLE`\n",
        "FROM\n",
        "  `Detail_Report`"
      ],
      "parameters": [
        {
          "displayName": "Tool Provider",
          "keyword": "param1",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "Goldy"
                }
              ]
            }
          }
        }
      ],
      "catalog": "adhoc_write_qastg",
      "schema": "dna_de"
    }
